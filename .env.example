# Copy to .env in the repository root. Never commit .env.
GEMINI_API_KEY=
# Set this to a structured-output-capable model available in your account.
GEMINI_MODEL=
# Supported on Gemini 3 Flash models; reduces latency without disabling verification.
GEMINI_THINKING_LEVEL=low
# Optional for the deployed console; omit to use an explicitly labelled browser sandbox.
DATABASE_URL=
# Generate a random secret of at least 32 characters for signed demo sessions.
SESSION_SECRET=
